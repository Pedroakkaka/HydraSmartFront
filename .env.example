# HydraSmart Front — copie para ".env" se precisar mudar algo.

# Endereço da API usado pelo servidor de desenvolvimento (npm run dev).
API_PROXY_TARGET=http://localhost:3333

# Deixe vazio para usar o mesmo endereço do painel (recomendado: nginx/Vite fazem o proxy).
# Preencha só se a API estiver em outro domínio, ex.: https://api.hydrasmart.com.br
VITE_API_URL=
