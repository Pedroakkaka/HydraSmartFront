{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hydrasmartapi.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://hydrasmartapi.onrender.com/docs"
    },
    {
      "source": "/((?!api/|ws$|docs$).*)",
      "destination": "/index.html"
    }
  ]
}
